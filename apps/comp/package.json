{
  "name": "@pwrup/comp",
  "version": "0.1.0",
  "description": "PWRUP Competition dashboard",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"cross-env NODE_OPTIONS=--no-experimental-webstorage next dev --port 3001\" \"wait-on http://127.0.0.1:3001 && cross-env ELECTRON_START_URL=http://127.0.0.1:3001 electron .\"",
    "build": "pnpm run electron:prepare && electron-builder --win --x64 --dir",
    "start": "concurrently -k \"cross-env NODE_OPTIONS=--no-experimental-webstorage next dev --port 3001\" \"wait-on http://127.0.0.1:3001 && cross-env ELECTRON_START_URL=http://127.0.0.1:3001 electron .\"",
    "lint": "eslint .",
    "electron:icon": "node scripts/generate-electron-icon.mjs",
    "electron:prepare": "pnpm run build:renderer && pnpm run electron:icon",
    "electron:dev": "concurrently -k \"cross-env NODE_OPTIONS=--no-experimental-webstorage next dev --port 3001\" \"wait-on http://127.0.0.1:3001 && cross-env ELECTRON_START_URL=http://127.0.0.1:3001 electron .\"",
    "electron:build:win": "pnpm run electron:prepare && electron-builder --win --x64 --dir",
    "electron:dist:win": "pnpm run electron:prepare && electron-builder --win --x64",
    "dev:renderer": "NODE_OPTIONS='--no-experimental-webstorage' next dev --port 3001",
    "build:renderer": "next build",
    "start:renderer": "next start -p 3001",
    "dist": "pnpm run electron:prepare && electron-builder --win --x64"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@pwrup/shared-core": "workspace:*",
    "@pwrup/shared-proto": "workspace:*",
    "@pwrup/shared-ui": "workspace:*",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-three/fiber": "^9.7.0",
    "autobahn-client": "^0.1.0",
    "bonjour-service": "^1.4.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.35.0",
    "next": "16.3.3",
    "ntcore-ts-client": "^3.1.3",
    "protobufjs": "^8.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.19.21",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.185.4",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "to-ico": "^1.1.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.pwrup.comp",
    "productName": "PWRUP Comp",
    "directories": {
      "output": "dist-electron-comp",
      "buildResources": "build"
    },
    "asar": true,
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "app",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "app/node_modules",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/static",
        "to": "app/.next/static",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public",
        "to": "app/public",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/icons/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "icon": "build/icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
